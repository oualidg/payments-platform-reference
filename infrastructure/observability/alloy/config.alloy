// ==============================================================================
// Grafana Alloy Configuration — Payments Platform
//
// Responsibilities:
//   1. Tail Docker container logs and ship to Loki
//
// Prometheus scraping is handled directly by Prometheus via prometheus.yml.
// All application services are reachable by container name on payments-network.
// ==============================================================================

// ==============================================================================
// Docker Log Collection
// ==============================================================================

discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  // Use container name as the service label
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service"
  }

  // Keep only our application containers — drop observability stack self-logs
  rule {
    source_labels = ["service"]
    regex         = "utility-account|mpesa-gateway|provisioning-service|nginx|rabbitmq|mongodb"
    action        = "keep"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}